# Bu dosyayı kopyalayıp .env olarak kaydet ve değerleri doldur:
# cp .env.example .env

# PostgreSQL
POSTGRES_DB_PASSWORD=

# Seq Log Arayüzü
SEQ_ADMIN_PASSWORD=

# JWT - Güçlü ve rastgele bir string olmalı (en az 32 karakter)
JWT_SECRET_KEY=

# RabbitMQ
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Migration çalıştırmak için (dotnet ef migrations add)
# Terminalde bir kez çalıştır, sonra migration komutunu ver:
# $env:IDENTITY_DB_CONNECTION="Host=localhost;Port=5432;Database=IdentityDb;Username=postgres;Password=BURAYA_SIFRE"
